# =============================================================================
# Frontend Public Configuration (Safe to expose in Vite bundle)
# =============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# =============================================================================
# Server-Side / Edge Function / Bootstrap Secrets
# NEVER prefix these with VITE_ and NEVER commit real values!
# =============================================================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional: Admin bootstrap script variables
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeStrongPassword123!
BOOTSTRAP_ADMIN_NAME=Quản trị viên
