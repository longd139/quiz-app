{
  "name": "quiz-luyen-tap",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "node scripts/guard-command.mjs dev",
    "dev:local": "node scripts/guard-command.mjs dev",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "db:start": "npx supabase start --exclude logflare,vector,realtime,imgproxy,supavisor",
    "db:start:full": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:status": "npx supabase status",
    "db:stats": "docker stats --no-stream --format \"table {{.Name}}\\t{{.CPUPerc}}\\t{{.MemUsage}}\"",
    "db:migrate:local": "node scripts/guard-command.mjs db:migrate:local",
    "db:seed:local": "node scripts/seed-local.mjs --preserve-existing",
    "db:reset:local": "node scripts/reset-local.mjs",
    "functions:serve:local": "node scripts/guard-command.mjs functions:serve:local",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/run-test-stack.mjs integration",
    "test:e2e": "node scripts/run-test-stack.mjs e2e",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "verify:quick": "npm run lint && npm run test:unit && npm run build",
    "verify:local": "npm run lint && npm run test:unit && npm run test:integration && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.108.4",
    "dompurify": "^3.5.0",
    "marked": "^18.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "supabase": "^3.4.0",
    "tailwindcss": "^4.1.4",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}
