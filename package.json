{
  "name": "quiz-luyen-tap",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "vite --mode development",
    "dev:local": "vite --mode development",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:status": "npx supabase status",
    "db:migrate:local": "npx supabase migration up --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "db:reset:local": "node scripts/reset-local.mjs",
    "functions:serve:local": "npx supabase functions serve --env-file supabase/functions/.env.local --no-verify-jwt",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "npx playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "verify:local": "npm run lint && npm run test:unit && npm run test:integration && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.108.4",
    "dompurify": "^3.5.0",
    "marked": "^18.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "supabase": "^3.4.0",
    "tailwindcss": "^4.1.4",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}
